<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>English Pronunciation Studio</title>

<style>

* {
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #e0f2fe, #fce7f3);
    min-height: 100vh;
    margin: 0;
    padding: 30px 15px;
    text-align: center;
}

.container {
    background: white;
    max-width: 650px;
    margin: auto;
    padding: 35px;
    border-radius: 25px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

h1 {
    color: #334155;
    font-size: 30px;
}

.subtitle {
    color: #64748b;
    margin-bottom: 30px;
}

textarea {
    width: 100%;
    height: 190px;
    padding: 20px;
    font-size: 19px;
    border: 2px solid #cbd5e1;
    border-radius: 15px;
    resize: vertical;
    outline: none;
    font-family: Arial, sans-serif;
    line-height: 1.6;
}

textarea:focus {
    border-color: #60a5fa;
}

.button-container {
    display: flex;
    gap: 15px;
    margin-top: 25px;
}

button {
    flex: 1;
    padding: 18px 12px;
    font-size: 17px;
    font-weight: bold;
    border: none;
    border-radius: 15px;
    cursor: pointer;
    transition: 0.2s;
}

button:hover {
    transform: translateY(-2px);
    opacity: 0.9;
}

.american {
    background: #3b82f6;
    color: white;
}

.british {
    background: #ec4899;
    color: white;
}

.stop {
    background: #475569;
    color: white;
    margin-top: 15px;
    width: 100%;
}

.speed-box {
    margin-top: 30px;
    padding: 20px;
    background: #f8fafc;
    border-radius: 15px;
}

input[type="range"] {
    width: 85%;
    margin-top: 15px;
    cursor: pointer;
}

.status {
    margin-top: 20px;
    font-size: 15px;
    color: #64748b;
    min-height: 24px;
}

.footer {
    margin-top: 25px;
    color: #94a3b8;
    font-size: 13px;
}

@media (max-width: 480px) {

    .container {
        padding: 23px;
    }

    h1 {
        font-size: 24px;
    }

    .button-container {
        flex-direction: column;
    }

}

</style>
</head>

<body>

<div class="container">

    <h1>🎙️ English Pronunciation Studio</h1>

    <p class="subtitle">
        Practice American & British English!
        🇺🇸 🇬🇧
    </p>

    <textarea
        id="textInput"
        placeholder="Type any English word or sentence here...

Example:
I would like a bottle of water."
    ></textarea>

    <div class="button-container">

        <button class="american" onclick="speak('en-US')">
            🇺🇸 American Accent
        </button>

        <button class="british" onclick="speak('en-GB')">
            🇬🇧 British Accent
        </button>

    </div>

    <button class="stop" onclick="stopSpeaking()">
        ⏹ Stop Speaking
    </button>

    <div class="speed-box">

        <h3>🎚 Speaking Speed</h3>

        <span id="speedValue">1.0x</span>

        <br>

        <input
            type="range"
            id="speed"
            min="0.5"
            max="1.5"
            step="0.1"
            value="1"
            oninput="updateSpeed()"
        >

        <p style="color:gray; font-size:14px;">
            Slow ← Normal → Fast
        </p>

    </div>

    <div class="status" id="status">
        Ready to speak! 🎧
    </div>

    <div class="footer">
        Made for English Learners ✨
    </div>

</div>

<script>

const synth = window.speechSynthesis;

let voices = [];

function loadVoices() {
    voices = synth.getVoices();
}

loadVoices();

if (synth.onvoiceschanged !== undefined) {
    synth.onvoiceschanged = loadVoices;
}

function findVoice(language) {

    loadVoices();

    const exactVoices = voices.filter(voice =>
        voice.lang.toLowerCase().replace("_", "-")
        === language.toLowerCase()
    );

    if (exactVoices.length > 0) {
        return exactVoices[0];
    }

    return null;
}

function speak(language) {

    const text = document
        .getElementById("textInput")
        .value.trim();

    const status = document.getElementById("status");

    if (!("speechSynthesis" in window)) {
        status.innerText =
            "Sorry, your browser does not support speech synthesis.";
        return;
    }

    if (text === "") {
        alert("Please enter some English text!");
        return;
    }

    synth.cancel();

    const utterance = new SpeechSynthesisUtterance(text);

    utterance.lang = language;

    const selectedVoice = findVoice(language);

    if (selectedVoice) {
        utterance.voice = selectedVoice;
    } else {
        status.innerText =
            "⚠️ No matching accent voice found. Trying browser default.";
    }

    const speed = parseFloat(
        document.getElementById("speed").value
    );

    utterance.rate = speed;
    utterance.pitch = 1;
    utterance.volume = 1;

    utterance.onstart = function() {

        if (language === "en-US") {
            status.innerText =
                "🇺🇸 Speaking in American English...";
        } else {
            status.innerText =
                "🇬🇧 Speaking in British English...";
        }

    };

    utterance.onend = function() {
        status.innerText = "✅ Finished speaking!";
    };

    utterance.onerror = function(event) {
        if (event.error !== "canceled" &&
            event.error !== "interrupted") {
            status.innerText =
                "⚠️ Speech playback failed: " + event.error;
        }
    };

    synth.speak(utterance);
}

function stopSpeaking() {

    synth.cancel();

    document.getElementById("status").innerText =
        "⏹ Speaking stopped.";

}

function updateSpeed() {

    const speed = document.getElementById("speed").value;

    document.getElementById("speedValue").innerText =
        Number(speed).toFixed(1) + "x";

}

</script>

</body>
</html>
